// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

// Note that some adapters may set a maximum length for the String type by default, please ensure your strings are long
// enough when changing adapters.
// See https://www.prisma.io/docs/orm/reference/prisma-schema-reference#string for more information
datasource db {
  provider = "postgresql"
  url      = env("DB_PRISMA_DATABASE_URL")
}

model Session {
  id                  String    @id
  shop                String
  state               String
  isOnline            Boolean   @default(false)
  scope               String?
  expires             DateTime?
  accessToken         String
  userId              BigInt?
  firstName           String?
  lastName            String?
  email               String?
  accountOwner        Boolean   @default(false)
  locale              String?
  collaborator        Boolean?  @default(false)
  emailVerified       Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?
}

model MerchantSession {
  id           String          @id @default(cuid())
  shop         String
  goal         String?
  status       String          @default("active")
  periodStart  DateTime?
  periodEnd    DateTime?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  researchRuns ResearchRun[]
  proposals    Proposal[]
  activity     ActivityEntry[]

  @@index([shop, createdAt])
}

model ResearchRun {
  id          String           @id @default(cuid())
  shop        String
  sessionId   String?
  session     MerchantSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  source      String
  query       String
  status      String           @default("completed")
  resultMeta  Json?
  startedAt   DateTime         @default(now())
  completedAt DateTime?

  @@index([shop, startedAt])
}

model Proposal {
  id                String             @id @default(cuid())
  shop              String
  sessionId         String?
  session           MerchantSession?   @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  type              String
  title             String
  rationale         String
  internalEvidence  Json
  externalEvidence  Json?
  affectedProductId String?
  status            String             @default("pending")
  currentRevision   Int                @default(1)
  createdByPairingId String?
  createdByPairing  AgentPairing?      @relation("AgentPairingProposals", fields: [createdByPairingId], references: [id], onDelete: SetNull)
  risk              String?
  uncertainty       String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  revisions         ProposalRevision[]
  decisions         ProposalDecision[]
  executions        Execution[]
  activity          ActivityEntry[]

  @@index([shop, status, createdAt])
  @@index([createdByPairingId])
}

model ProposalRevision {
  id              String             @id @default(cuid())
  proposalId      String
  proposal        Proposal           @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  revision        Int
  beforeState     Json
  proposedChanges Json
  createdAt       DateTime           @default(now())
  decisions       ProposalDecision[]
  executions      Execution[]

  @@unique([proposalId, revision])
}

model ProposalDecision {
  id         String           @id @default(cuid())
  proposalId String
  proposal   Proposal         @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  revisionId String
  revision   ProposalRevision @relation(fields: [revisionId], references: [id], onDelete: Cascade)
  decision   String
  actor      String           @default("merchant")
  notes      String?
  createdAt  DateTime         @default(now())

  @@index([proposalId, createdAt])
}

model Execution {
  id          String           @id @default(cuid())
  shop        String
  proposalId  String
  proposal    Proposal         @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  revisionId  String
  revision    ProposalRevision @relation(fields: [revisionId], references: [id], onDelete: Cascade)
  resourceId  String?
  status      String           @default("pending")
  beforeState Json?
  afterState  Json?
  error       String?
  startedAt   DateTime         @default(now())
  completedAt DateTime?

  @@index([shop, startedAt])
}

model ActivityEntry {
  id         String           @id @default(cuid())
  shop       String
  sessionId  String?
  session    MerchantSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  proposalId String?
  proposal   Proposal?        @relation(fields: [proposalId], references: [id], onDelete: SetNull)
  actor      String
  tool       String?
  type       String
  summary    String
  metadata   Json?
  createdAt  DateTime         @default(now())

  @@index([shop, createdAt])
}

model AgentPairing {
  id          String   @id @default(cuid())
  shop        String
  tokenHash   String   @unique
  sessionHash String?  @unique
  expiresAt   DateTime?
  claimedAt   DateTime?
  revokedAt   DateTime?
  lastUsedAt  DateTime?
  createdAt   DateTime @default(now())
  proposals   Proposal[] @relation("AgentPairingProposals")

  @@index([shop, expiresAt])
}
